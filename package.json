{
  "name": "vue-force-graph-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:examples": "turbo run dev --filter=./examples/vue-force-graph*",
    "dev:2d": "turbo run dev --filter vue-force-graph-2d",
    "dev:3d": "turbo run dev --filter vue-force-graph-3d",
    "dev:ar": "turbo run dev --filter vue-force-graph-ar",
    "dev:vr": "turbo run dev --filter vue-force-graph-vr",
    "dev:vfg": "turbo run dev --filter vue-force-graph",
    "dev:graph": "turbo run dev --filter=./packages/vue-force-graph*",
    "dev:utils": "turbo run dev --filter utils",
    "lint:fmt": "oxfmt",
    "lint": "oxlint",
    "change": "pnpm changeset",
    "change:v": "pnpm changeset version",
    "ci:publish": "pnpm publish -r ",
    "lint:cspell": "cspell ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@cspell/dict-lorem-ipsum": "^4.0.5",
    "@tsdown/css": "^0.22.1",
    "@types/three": "^0.184.1",
    "cspell": "^9.8.0",
    "lefthook": "^2.1.8",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.67.0",
    "tsdown": "^0.22.1",
    "turbo": "^2.9.16",
    "typescript": "~6.0.3",
    "unplugin-vue": "^7.2.0",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.2"
  },
  "packageManager": "pnpm@11.2.2"
}
