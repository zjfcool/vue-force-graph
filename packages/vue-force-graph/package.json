{
  "name": "vue-force-graph",
  "version": "1.1.0",
  "description": "Vue component for 2D, 3D, VR and AR force directed graphs",
  "keywords": [
    "2d",
    "3d",
    "ar",
    "canvas",
    "force",
    "graph",
    "three",
    "vr",
    "vue",
    "webgl"
  ],
  "homepage": "https://github.com/zjfcool/vue-force-graph",
  "license": "MIT",
  "author": {
    "name": "zjfcool",
    "url": "https://github.com/zjfcool"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjfcool/vue-force-graph.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "vue-force-graph-2d": "workspace:*",
    "vue-force-graph-3d": "workspace:*",
    "vue-force-graph-ar": "workspace:*",
    "vue-force-graph-vr": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  }
}
