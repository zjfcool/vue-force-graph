{
  "name": "vue-force-graph-ar",
  "version": "1.1.0",
  "description": "A Vue component for rendering  AR force directed graphs, powered by the 3d-force-graph-ar library.",
  "keywords": [
    "3d",
    "aframe",
    "ar",
    "ar.js",
    "force",
    "graph",
    "vue",
    "webgl"
  ],
  "homepage": "https://zjfcool.github.io/vue-force-graph/ar/",
  "license": "MIT",
  "author": {
    "name": "zjfcool",
    "url": "https://github.com/zjfcool"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjfcool/vue-force-graph.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "3d-force-graph-ar": "^1.10.0"
  },
  "devDependencies": {
    "utils": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.34"
  }
}
