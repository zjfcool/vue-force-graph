{
  "name": "vue-force-graph-3d",
  "version": "1.1.1",
  "description": "A Vue component for rendering 3D force-directed graph, powered by the 3d-force-graph library.",
  "keywords": [
    "3d",
    "force",
    "graph",
    "ngraph",
    "three",
    "vue",
    "webgl"
  ],
  "homepage": "https://zjfcool.github.io/vue-force-graph/3d/",
  "license": "MIT",
  "author": {
    "name": "zjfcool",
    "url": "https://github.com/zjfcool"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjfcool/vue-force-graph.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
